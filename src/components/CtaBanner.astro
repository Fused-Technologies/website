---
import site from '../content/site.json';

interface Props {
  heading: string;
  text: string;
  callout?: string;
  image: string;
  imageAlt?: string;
  buttonLabel?: string;
}
const { heading, text, callout, image, imageAlt = '', buttonLabel = site.ctaLabel } = Astro.props;
---
<section class="cta">
  <div class="cta__image">
    <img src={image} alt={imageAlt} loading="lazy" />
  </div>
  <div class="cta__content">
    <div class="cta__inner">
      <h2>{heading}</h2>
      <p>{text}</p>
      {callout && <p class="cta__callout">{callout}</p>}
      <a href={site.ctaHref} class="btn btn--white">{buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 46% 54%;
    min-height: 680px;
  }
  .cta__image img { width: 100%; height: 100%; object-fit: cover; }
  .cta__content {
    background: linear-gradient(rgba(94, 178, 44, 0.9), rgba(94, 178, 44, 0.9)), url('/images/cta-team.jpg') center / cover;
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 64px 48px;
  }
  .cta__inner { max-width: 580px; }
  .cta h2 { font-size: clamp(1.8rem, 2.8vw, 2.5rem); margin-bottom: 28px; }
  .cta p { opacity: 0.95; }
  .cta__callout { font-weight: 600; font-size: 1.1rem; margin: 24px 0 40px; }

  @media (max-width: 900px) {
    .cta { grid-template-columns: 1fr; min-height: 0; }
    .cta__image { max-height: 360px; overflow: hidden; }
    .cta__content { padding: 56px 20px; }
  }
</style>
