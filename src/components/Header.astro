---
import site from '../content/site.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tel = (n: string) => 'tel:' + n.replace(/[^\d+]/g, '');
---
<div class="topbar">
  <div class="container topbar__inner">
    <nav class="topbar__links" aria-label="Secondary">
      {site.topNav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="topbar__phones">
      <span>Client Support: <a href={tel(site.clientSupport.phone)}>{site.clientSupport.phone}</a></span>
      <span>Sales Inquiries: <a href={tel(site.sales.phone)}>{site.sales.phone}</a></span>
    </div>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label={`${site.name} home`}>
      <img src="/images/logo.png" alt={site.name} width="210" height="61" />
    </a>

    <button class="header__toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="main-nav" class="header__nav" aria-label="Main">
      <ul>
        {site.nav.map((l) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a href={site.ctaHref} class="btn btn--green btn--sm">{site.ctaLabel}</a>
      <div class="header__mobile-extra">
        {site.topNav.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={tel(site.clientSupport.phone)}>Client Support: {site.clientSupport.phone}</a>
        <a href={tel(site.sales.phone)}>Sales: {site.sales.phone}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });
</script>

<style>
  .topbar {
    background: var(--navy-dark);
    color: var(--white);
    font-size: 0.875rem;
  }
  .topbar__inner {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 56px;
    min-height: 50px;
  }
  .topbar__links { display: flex; gap: 36px; }
  .topbar a { text-decoration: none; font-weight: 600; }
  .topbar a:hover { color: var(--green); }
  .topbar__phones { display: flex; gap: 56px; }

  /* Header sits on top of the page hero */
  .header {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 20;
    color: var(--white);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 160px;
  }
  .header__logo { position: relative; z-index: 2; }
  .header__logo img { width: 210px; height: auto; }

  .header__nav { display: flex; align-items: center; gap: 32px; }
  .header__nav ul { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; }
  .header__nav ul a {
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }
  .header__nav ul a:hover,
  .header__nav ul a[aria-current='page'] { border-bottom-color: var(--green); }
  .header__mobile-extra { display: none; }

  .header__toggle {
    display: none;
    background: none;
    border: 0;
    padding: 10px;
    cursor: pointer;
  }
  .header__toggle span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--white);
    margin: 6px 0;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .header__toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .header__toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .header__toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  @media (max-width: 1024px) {
    .topbar { display: none; }
    .header__inner { min-height: 96px; }
    .header__logo img { width: 160px; }
    .header__toggle { display: block; position: relative; z-index: 2; }
    .header__nav {
      display: none;
      position: fixed;
      inset: 0;
      background: var(--navy);
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 24px;
      padding: 110px 24px 40px;
      overflow-y: auto;
    }
    .header__nav.is-open { display: flex; }
    .header__nav ul { flex-direction: column; gap: 18px; }
    .header__nav ul a { font-size: 1.15rem; }
    .header__mobile-extra {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      width: 100%;
    }
    .header__mobile-extra a { text-decoration: none; color: rgba(255, 255, 255, 0.85); }
  }
  :global(body.nav-open) { overflow: hidden; }
</style>
