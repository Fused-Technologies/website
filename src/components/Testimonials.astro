---
import testimonials from '../content/testimonials.json';
---
<div class="testimonials">
  {testimonials.map((t, i) => (
    <figure class:list={['testimonial', { 'testimonial--featured': i === 1 }]}>
      <img src="/images/icons/stars.svg" alt="5 out of 5 stars" width="96" height="18" class="testimonial__stars" />
      <h3 class="testimonial__title">"{t.title}"</h3>
      <blockquote>"{t.quote}"</blockquote>
      <figcaption>
        <img src={t.avatar} alt="" width="68" height="68" loading="lazy" />
        <div>
          <strong>{t.name}</strong>
          <span>{t.role}</span>
        </div>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .testimonials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
  }
  .testimonial {
    margin: 0;
    background: var(--white);
    border-radius: var(--radius);
    padding: 40px 26px;
    box-shadow: var(--shadow);
  }
  .testimonial--featured {
    position: relative;
    z-index: 1;
    padding-top: 56px;
    padding-bottom: 72px;
    margin: 0 -12px;
    box-shadow: 0 24px 70px rgba(16, 24, 40, 0.14);
  }
  .testimonial__stars { width: 96px; margin-bottom: 20px; }
  .testimonial__title { font-style: italic; font-size: 1.3rem; }
  .testimonial blockquote {
    margin: 0 0 32px;
    font-style: italic;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .testimonial figcaption { display: flex; align-items: center; gap: 16px; }
  .testimonial figcaption img { width: 68px; height: 68px; flex-shrink: 0; }
  .testimonial strong {
    display: block;
    font-family: var(--font-sub);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
  }
  .testimonial figcaption span { font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; display: block; }

  @media (max-width: 960px) {
    .testimonials { grid-template-columns: 1fr; gap: 24px; max-width: 560px; margin: 0 auto; }
    .testimonial--featured { margin: 0; padding: 40px 26px; }
  }
</style>
