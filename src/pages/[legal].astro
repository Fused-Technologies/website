---
/* Privacy Policy and SMS Privacy Policy, from src/content/legal/*.md */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((entry) => ({ params: { legal: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} | Fused Technologies`} description={entry.data.description}>
  <PageHero title={entry.data.title} />
  <section class="section">
    <div class="container legal prose">
      <Content />
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 860px; }
</style>
