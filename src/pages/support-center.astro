---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import page from '../content/pages/support-center.json';
import site from '../content/site.json';

const tel = (n: string) => 'tel:' + n.replace(/[^\d+]/g, '');
---
<Base title={page.seo.title} description={page.seo.description}>
  <PageHero {...page.hero} />
  <section class="section">
    <div class="container support">
      <h2>{page.heading}</h2>
      <p>
        {page.intro} <a href="/schedule-an-appointment">Schedule Appointment</a> page.
      </p>

      <h3>{page.hoursHeading}</h3>
      <ul class="support__hours">{page.hours.map((h) => <li>{h}</li>)}</ul>

      <div class="support__cards">
        <a class="support__card" href={`mailto:${site.clientSupport.email}`}>
          <strong>Email Support</strong>
          <span>{site.clientSupport.email}</span>
        </a>
        <a class="support__card" href={tel(site.clientSupport.phone)}>
          <strong>Phone Support</strong>
          <span>{site.clientSupport.phone}</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .support { max-width: 900px; }
  .support h2 { text-align: center; margin-bottom: 32px; }
  .support p { color: var(--text-muted); font-size: 1.05rem; }
  .support p a { color: var(--green); }
  .support h3 { margin-top: 40px; font-size: 1.4rem; }
  .support__hours { padding-left: 20px; display: grid; gap: 8px; color: var(--text-muted); }
  .support__hours li::marker { color: var(--green); }
  .support__cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 40px; }
  .support__card {
    display: grid;
    gap: 6px;
    background: var(--green-tint);
    border-radius: var(--radius);
    padding: 24px 28px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .support__card:hover { transform: translateY(-2px); }
  .support__card strong { font-family: var(--font-heading); font-size: 1.15rem; }
  .support__card span { color: var(--text-muted); overflow-wrap: anywhere; }
  @media (max-width: 640px) { .support__cards { grid-template-columns: 1fr; } }
</style>
