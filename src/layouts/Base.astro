---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cleanPath } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Landing-page header: logo + heading, no menu (used on the booking page) */
  minimalHeader?: string;
  noindex?: boolean;
}

const { title, description = '', image = '/images/logo.png', minimalHeader, noindex = false } = Astro.props;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <Header minimal={minimalHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
